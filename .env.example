# Copy to .env (`make setup` does this) and change the passwords.
# Use letters and digits only in POSTGRES_PASSWORD: it is placed inside a URL.

POSTGRES_USER=notes
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=notes

# Which image/tag to run. CI sets APP_TAG to the git sha; scripts/deploy.sh
# updates this line after a successful deploy. Leave APP_IMAGE alone to build locally.
APP_TAG=local
#APP_IMAGE=ghcr.io/<your-user>/<your-repo>-app

APP_REPLICAS=2
PROXY_PORT=8080
LOG_LEVEL=INFO

# Start the monitoring stack (Prometheus, Grafana, Loki, Promtail) as well.
# Empty this value to run only the core services.
COMPOSE_PROFILES=monitoring
GRAFANA_PASSWORD=change_me_too

# Crash/sicken switches used by scripts/demo-crash.sh. Keep false anywhere real.
ENABLE_CHAOS=true

# Backups: one dump every hour, keep the newest 7.
BACKUP_INTERVAL_SECONDS=3600
BACKUP_KEEP=7
